<?xml version="1.0"?>
<package format="3">
  <name>navigation_lab</name><version>0.1.0</version>
  <description>ROS 2 adapter for the shared Rust navigation core.</description>
  <maintainer email="leo.maglanoc@gmail.com">Leonardo Maglanoc</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>navigation_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
